# Runtime JSON database + Gmail token store (written by the server; never
# commit). The server creates data/rcos_db.json on first boot. On Railway,
# point DATA_DIR at a persistent volume.
data/*.json
data/*.json.*
data/*.bak
data/*.tmp

# Firebase Android config (google-services.json) — per-project file from
# the Firebase console; placed in app/ by hand and must never be committed.
app/google-services.json
android/app/google-services.json
